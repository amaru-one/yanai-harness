{
  "proyecto": "Yanai — aplicación docente",

  "repo": {
    "path": "../app-docente",
    "extensiones": [".go", ".svelte", ".ts", ".js", ".sql", ".html", ".css", ".md", ".json"],
    "excluir_dirs": ["node_modules", "vendor", "dist", "build", ".svelte-kit", "testdata", "yanai-workspace"],
    "prioritarios": ["go.mod", "package.json", "README.md", "schema.sql"],
    "max_bytes_archivo": 24000,
    "max_bytes_total": 400000
  },

  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "referer": "https://github.com/yanai/equipo",
    "title": "Yanai - equipo de agentes",
    "timeout_segundos": 600,
    "reintentos": 3
  },

  "orden_discusion": ["arquitecto-bd", "disenador", "ingeniero"],

  "agentes": {
    "product-owner": {
      "nombre": "Product Owner",
      "model": "anthropic/claude-sonnet-4.5",
      "temperature": 0.3,
      "max_tokens": 12000,
      "prompt": "prompts/product-owner.md"
    },
    "arquitecto-bd": {
      "nombre": "Arquitecto de BD (CNEB / MINEDU)",
      "model": "anthropic/claude-sonnet-4.5",
      "temperature": 0.2,
      "max_tokens": 16000,
      "prompt": "prompts/arquitecto-bd.md"
    },
    "ingeniero": {
      "nombre": "Software Engineer (Go / Svelte)",
      "model": "anthropic/claude-sonnet-4.5",
      "temperature": 0.2,
      "max_tokens": 16000,
      "prompt": "prompts/ingeniero.md"
    },
    "disenador": {
      "nombre": "Diseñador UI/UX",
      "model": "anthropic/claude-sonnet-4.5",
      "temperature": 0.5,
      "max_tokens": 16000,
      "prompt": "prompts/disenador.md"
    }
  }
}
